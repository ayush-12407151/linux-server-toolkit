# Copy this file to toolkit.conf and edit for your server.
BACKUP_SOURCES=("/etc" "/home")
BACKUP_DIR="/opt/linux-server-toolkit/backups"
RETENTION_DAYS=7

LOG_CLEANUP_DIRS=("/var/log")
LOG_COMPRESS_DAYS=3
LOG_DELETE_DAYS=30

SERVICES_TO_MONITOR=("nginx" "ssh")

DISK_WARN_THRESHOLD=80
DISK_CRIT_THRESHOLD=90

WEBHOOK_URL=""
